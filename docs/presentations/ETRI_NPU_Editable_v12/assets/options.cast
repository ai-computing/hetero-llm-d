[3.694, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[21;1H\u2502\u001b[21;11H\u001b[38;2;141;202;186;49mvia InferencePool \u25cf\u001b[38;2;175;166;174;49m                                                                                                      \u001b[38;2;92;95;119;49m\u2502\u001b[22;1H\u2502\u001b[22;4H\u001b[38;2;175;166;174;49mllmd-router      \u001b[22;41H                                                                                           \u001b[38;2;92;95;119;49m\u2502\u001b[23;1H\u2502\u001b[23;4H\u001b[38;2;175;166;174;49mgemma4-rbln-pool \u001b[23;41H                                                                                           \u001b[38;2;92;95;119;49m\u2502\u001b[24;1H\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
