[3.728, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[15;1H\u2502\u001b[38;2;158;224;160;49m\u25cf \u001b[1mGB10\u00d71 \u001b[15;29H\u001b[22m\u001b[38;2;240;137;176;49m\u25cf\u25cf\u25cf\u25cf\u25cf\u25cf\u25cf\u25cf\u25cf\u001b[38;2;72;74;94;49m\u00b7\u001b[38;2;240;137;176;49m  94% \u001b[15;49H\u001b[38;2;72;74;94;49m\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[15;77H\u001b[38;2;240;137;176;49m             \u2584\u001b[38;2;190;189;189;49m                                         \u001b[38;2;72;74;94;49m\u2502\u001b[16;1H\u2502\u001b[38;2;158;224;160;49m\u25cf \u001b[1mGB10\u00d71 \u001b[16;29H\u001b[22m\u001b[38;2;72;74;94;49m\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[16;49H\u001b[38;2;158;224;160;49m\u25cf\u001b[38;2;72;74;94;49m\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[38;2;158;224;160;49m   8/129GB  \u001b[16;91H\u001b[38;2;190;189;189;49m                                         \u001b[38;2;72;74;94;49m\u2502\u001b[17;1H\u2502\u001b[38;2;158;224;160;49m\u25cf \u001b[1m\u001b[38;2;197;162;245;49mRBLN\u00d74 \u001b[17;29H\u001b[22m\u001b[38;2;72;74;94;49m\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7"]
[3.728, "o", "\u00b7\u00b7\u00b7\u001b[17;49H\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[17;91H\u001b[38;2;190;189;189;49m                                         \u001b[38;2;72;74;94;49m\u2502\u001b[18;1H\u2502\u001b[18;37H\u001b[38;2;190;189;189;49m                                                                                               \u001b[38;2;72;74;94;49m\u2502\u001b[19;1H\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[20;1H\u256d\u001b[1m\u001b[38;2;135;214;232;49m Inference (EPP / InferencePool) \u001b[22m\u001b[38;2;72;74;94;49m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[3.728, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[21;1H\u2502\u001b[21;11H\u001b[38;2;158;224;160;49mvia InferencePool \u25cf\u001b[38;2;190;189;189;49m                                                                                                      \u001b[38;2;72;74;94;49m\u2502\u001b[22;1H\u2502\u001b[22;4H\u001b[38;2;190;189;189;49mllmd-router      \u001b[22;41H                                                                                           \u001b[38;2;72;74;94;49m\u2502\u001b[23;1H\u2502\u001b[23;4H\u001b[38;2;190;189;189;49mgemma4-rbln-pool \u001b[23;41H                                                                                           \u001b[38;2;72;74;94;49m\u2502\u001b[24;1H\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[25;1H"]
