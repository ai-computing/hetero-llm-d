          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "SLO attainment",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 12,
        "h": 8
      },
