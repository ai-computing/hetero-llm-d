          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "airm_kv_transfer_gbps{component=~\"$component\", model=~\"$model\"}",
          "legendFormat": "{{component}} {{kv_transport}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
