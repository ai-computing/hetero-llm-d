    },
    {
      "type": "timeseries",
      "title": "Accuracy (dataset)",
      "gridPos": {
        "x": 12,
        "y": 47,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "airm_accuracy_pct{component=~\"$component\", model=~\"$model\"}",
          "legendFormat": "{{component}} {{model}} {{dataset}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    }
  ]
}
