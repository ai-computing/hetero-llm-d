# Site-specific values for this cluster. Copy to cluster.local.env (untracked, see .gitignore)
# and fill in the real values; scripts/lib/cluster-env.sh loads it, and scripts that need a
# value fail with a clear message when it is missing. Values already set in the environment win.
#
# Placeholders used in the docs (README.md, STATUS.md, PLAYBOOK.md, docs/):
#   <gateway-host>   envoy-gateway LoadBalancer address (llm-d-gateway, Cilium L2 announcement)
#   <cp-node-ip>     control-plane node (control-node): kube-apiserver, NodePorts
#   <npu-node-1-ip>  worker npu-node-1 (RBLN x4, RNGD x3)
#   <e11-ip>         worker npu-node-2 (RNGD x2, A100 x2, SSH on a non-default port)
#   <gb10-a-ip>, <gb10-b-ip>   GB10 nodes gb10-node-1, gb10-node-2 (separate subnet)
#   <nas-host>       NAS serving the SMB shares (model store, lab shares)
#   <doc-nas-host>   NAS holding the RAG document source
#   <site-subnet>, <site-gw>   node subnet and its default gateway; <gb10-subnet> the GB10 subnet
#   <pod-cidr>, <svc-cidr>     cluster-internal pod / service ranges (kubeadm, Cilium)
#   <미할당 IP>      addresses not assigned by IT (never put them in the LB IP pool)
# Fixed-width screenshots and recordings (docs/*.cast, docs/images/*.svg, ASCII diagrams) use
# RFC 5737 addresses 198.51.100.x instead, keeping the host part: .105 = control-plane,
# .183 = npu-node-1, .126 = e11, .233 = gateway.

# kubeadm (scripts/02-cp-init-cluster.sh, 03-worker-install.sh)
LLMD_CP_IP=<cp-node-ip>
LLMD_POD_CIDR=<pod-cidr>
LLMD_SVC_CIDR=<svc-cidr>

# llm-d gateway address (manifests/epp/make-epp.sh health test, docs examples)
LLMD_GATEWAY_HOST=<gateway-host>

# Prometheus host:port seen from the control-plane (scripts/capture-lmd-top.sh, lmd-top LMD_PROM)
LLMD_PROM_ADDR=<cp-node-ip>:30090

# SMB share backing the model-store PV (manifests/model-store.yaml, rendered by scripts/render-manifest.sh)
LLMD_MODEL_STORE_SMB=//<nas-host>/<share>

# Node names and the home directory on the NPU workers (manifests that pin pods to a node or mount
# hostPaths under the home directory; rendered by scripts/render-manifest.sh; scripts/hetero-sweep.py)
LLMD_NODE_NPU1=npu-node-1
LLMD_NODE_NPU2=npu-node-2
LLMD_HOME=/home/<user>

# Optional: account that gets a kubeconfig from scripts/02-cp-init-cluster.sh (default: the sudo user)
# LLMD_KUBE_USER=<user>
